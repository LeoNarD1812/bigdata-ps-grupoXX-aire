
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telemetria de aeronaves V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "icao24",
    "timePosition",
    "eventTime",
    "latitude",
    "longitude",
    "onGround",
    "observedAt",
    "source"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "const": "aeronave.telemetria"
    },
    "schemaVersion": {
      "const": 1
    },
    "icao24": {
      "type": "string",
      "pattern": "^[0-9a-f]{6}$"
    },
    "callsign": {
      "type": ["string", "null"]
    },
    "originCountry": {
      "type": ["string", "null"]
    },
    "timePosition": {
      "type": "integer",
      "minimum": 1
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "baroAltitude": {
      "type": ["number", "null"],
      "minimum": -500,
      "maximum": 20000
    },
    "onGround": {
      "type": "boolean"
    },
    "velocity": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 400
    },
    "trueTrack": {
      "type": ["number", "null"]
    },
    "verticalRate": {
      "type": ["number", "null"],
      "minimum": -100,
      "maximum": 100
    },
    "geoAltitude": {
      "type": ["number", "null"]
    },
    "positionSource": {
      "type": ["integer", "null"]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "opensky"
    }
  }
}
